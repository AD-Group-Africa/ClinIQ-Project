# ============================================================
# ClinIQ Environment Variables
# Copy to .env and fill values before running
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DB_NAME=cliniq
DB_USER=cliniq
DB_PASSWORD=CHANGE_ME_strong_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- JWT (generate: openssl rand -base64 64) ---
JWT_SECRET=CHANGE_ME_minimum_64_characters_random_string_here_replace_now

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod

# --- Africa's Talking SMS ---
AT_API_KEY=your_api_key_from_africastalking_com
AT_USERNAME=your_username

# --- M-Pesa Daraja ---
MPESA_CONSUMER_KEY=from_developer_safaricom_co_ke
MPESA_CONSUMER_SECRET=from_developer_safaricom_co_ke
MPESA_SHORTCODE=174379
MPESA_PASSKEY=from_developer_portal
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/billing/mpesa/callback
MPESA_SANDBOX=false

# --- WhatsApp Business ---
WHATSAPP_PHONE_ID=from_meta_developers
WHATSAPP_ACCESS_TOKEN=from_meta_developers
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_random_token

# --- App ---
FRONTEND_URL=https://your-domain.com
