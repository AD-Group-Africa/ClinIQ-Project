<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Mask secrets, JWTs, passwords, PHI in logs -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{requestId:-}] %15.15t %-40.40logger{39} : %replace(%m){'(?i)(password|passwd|pwd|secret|api[_-]?key|authorization|bearer|jwt|refresh[_-]?token|mpesa|at[_-]?api)[=:\s]*[^\s,]*', '$1=***'}%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.cliniq" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="WARN"/>
</configuration>
